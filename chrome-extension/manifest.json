{
  "manifest_version": 3,
  "name": "GOAT Image Capture",
  "version": "0.5.0",
  "description": "Right-click an image and add it to a GOAT category. Categories come from the GOAT words sheet.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://goat-image-ingest.jeremy-86d.workers.dev/*",
    "https://docs.google.com/*",
    "https://images.froobaloo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
